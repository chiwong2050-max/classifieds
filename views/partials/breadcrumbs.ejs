<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/">Home</a>
  <% items.forEach(function (it) { %>
    <span class="sep" aria-hidden="true">›</span>
    <% if (it.url) { %>
      <a href="<%= it.url %>"><%= it.name %></a>
    <% } else { %>
      <span aria-current="page"><%= it.name %></span>
    <% } %>
  <% }); %>
</nav>
