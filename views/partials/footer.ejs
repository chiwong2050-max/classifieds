<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">C</span><span><%= site.name %></span></a>
        <p class="small mt-4"><%= site.tagline %>. A family-safe place to buy, sell and connect. Every ad is reviewed before it goes live.</p>
        <a class="coffee" href="<%= site.buyMeACoffeeUrl %>" target="_blank" rel="noopener noreferrer">
          <span aria-hidden="true">☕</span> Buy me a coffee
        </a>
      </div>
      <div>
        <h3>Browse</h3>
        <ul class="footer-links">
          <% categories.slice(0, 5).forEach(function (c) { %>
            <li><a href="/<%= site.defaultCountry %>/<%= c.slug %>/"><%= c.name %></a></li>
          <% }); %>
        </ul>
      </div>
      <div>
        <h3>Company</h3>
        <ul class="footer-links">
          <li><a href="/post/">Post an ad</a></li>
          <li><a href="/safety/">Safety tips</a></li>
          <li><a href="/terms/">Terms</a></li>
          <li><a href="/privacy/">Privacy</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p class="small mb-0">© <%= year %> <%= site.name %>. All rights reserved.</p>
      <p class="small mb-0 muted">Made for local communities. No personals, no adult content.</p>
    </div>
  </div>
</footer>
