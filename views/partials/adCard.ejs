<article class="card ad-card">
  <a class="thumb" href="<%= urls.adUrl(ad) %>">
    <% if (ad.primary_image) { %>
      <img src="<%= imageThumbUrl(ad.primary_image) %>" alt="" loading="lazy" width="480" height="360">
    <% } else { %>
      <span class="ph" aria-hidden="true"><%- include('icon', { name: 'tag', klass: 'ph-ico' }) %></span>
    <% } %>
  </a>
  <div class="body">
    <a class="title" href="<%= urls.adUrl(ad) %>"><%= ad.title %></a>
    <div class="price"><%= helpers.formatPrice(ad.price_cents, ad.currency, ad.price_type) %></div>
    <div class="meta">
      <span><%= ad.city_name %></span>
      <span><%= helpers.timeAgo(ad.published_at || ad.created_at) %></span>
    </div>
  </div>
</article>
