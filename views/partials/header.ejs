<header class="site-header">
  <div class="container">
    <a class="brand" href="/" aria-label="<%= t('nav.brandHome', { siteName: site.name }) %>">
      <span class="brand-mark" aria-hidden="true">LN</span>
      <span><%= site.name %></span>
    </a>

    <form class="header-search" role="search" action="/search" method="get">
      <label class="hidden" for="header-q"><%= t('nav.searchListings') %></label>
      <div class="searchbar">
        <input id="header-q" type="search" name="q" placeholder="<%= t('nav.searchPlaceholder') %>" value="<%= query.q || '' %>" autocomplete="off">
        <button class="btn btn-brand btn-sm" type="submit"><%= t('common.search') %></button>
      </div>
    </form>

    <nav class="header-nav" aria-label="<%= t('nav.main') %>">
      <% if (site.alternates && site.alternates.length > 1) { %>
        <%# Country picker. Links keep the current path on the other host for
            global pages and fall back to that market's home page for
            location-scoped URLs (see alternatePath). %>
        <details class="market-picker">
          <summary>
            <span class="hidden"><%= t('nav.changeMarket') %></span>
            <span class="market-picker-label"><%= site.countryName %></span>
          </summary>
          <div class="market-menu-wrap">
            <% if (site.alternates.length > 10) { %>
              <label class="hidden" for="market-filter"><%= t('nav.filterCountries') %></label>
              <input id="market-filter" class="market-filter" type="search" data-market-filter
                     placeholder="<%= t('nav.filterCountries') %>" autocomplete="off">
            <% } %>
            <ul class="market-menu" data-market-menu>
              <% site.alternates.forEach(function (alt) { %>
                <li data-market-name="<%= String(alt.label).toLowerCase() %>">
                  <% if (alt.key === site.key) { %>
                    <span class="market-current" aria-current="true"><%= alt.label %></span>
                  <% } else { %>
                    <a href="<%= alt.url %><%= alternatePath || '/' %>" hreflang="<%= alt.hreflang %>"><%= alt.label %></a>
                  <% } %>
                </li>
              <% }); %>
            </ul>
          </div>
        </details>
      <% } %>
      <a class="navlink" href="/browse/"><%= t('nav.browse') %></a>
      <% if (isAdmin) { %><a class="navlink" href="/admin"><%= t('nav.admin') %></a><% } %>
      <a class="btn btn-primary btn-sm" href="/post/"><%= t('nav.postAd') %></a>
    </nav>
  </div>
</header>
