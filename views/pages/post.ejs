<%- include('../partials/head') %>
<div class="container mt-4">
  <%- include('../partials/breadcrumbs', { items: [{ name: t('post.title') }] }) %>
  <h1><%= t('post.title') %></h1>
  <p class="muted"><%= t('post.intro') %></p>

  <% if (Object.keys(errors).length) { %>
    <div class="alert alert-err"><%= t('post.fixErrors') %></div>
  <% } %>

  <form method="post" action="/post/" enctype="multipart/form-data" data-post-form>
    <fieldset>
      <legend><%= t('post.whatPosting') %></legend>
      <div class="field">
        <label for="category"><%= t('post.category') %> <span aria-hidden="true">*</span></label>
        <select id="category" name="category" required data-category-select>
          <option value=""><%= t('post.chooseCategory') %></option>
          <% categories.forEach(function (c) { %>
            <option value="<%= c.slug %>" <%= (values.category === c.slug) ? 'selected' : '' %>><%= c.name %></option>
          <% }); %>
        </select>
        <% if (errors.category) { %><p class="field-error"><%= errors.category %></p><% } %>
      </div>

      <div class="field">
        <label for="title"><%= t('post.titleLabel') %> <span aria-hidden="true">*</span></label>
        <input id="title" type="text" name="title" maxlength="120" required value="<%= values.title || '' %>" placeholder="<%= t('post.titlePlaceholder') %>">
        <% if (errors.title) { %><p class="field-error"><%= errors.title %></p><% } %>
        <p class="hint"><%= t('post.titleHint') %></p>
      </div>

      <div class="field">
        <label for="description"><%= t('post.description') %> <span aria-hidden="true">*</span></label>
        <textarea id="description" name="description" required minlength="20" maxlength="5000" placeholder="<%= t('post.descriptionPlaceholder') %>"><%= values.description || '' %></textarea>
        <% if (errors.description) { %><p class="field-error"><%= errors.description %></p><% } %>
      </div>
    </fieldset>

    <fieldset>
      <legend><%= t('post.photos') %> <span class="muted small">(<%= t('post.photosOptional', { max: maxImages }) %>)</span></legend>
      <div class="field">
        <label for="images"><%= t('post.addPhotos') %></label>
        <input id="images" type="file" name="images" accept="image/*" multiple data-images-input data-count-one="<%= t('js.photosSelected.one') %>" data-count-other="<%= t('js.photosSelected.other') %>">
        <p class="hint"><%= t('post.photoHint') %></p>
        <p class="img-count" data-images-count></p>
      </div>
    </fieldset>

    <fieldset>
      <legend><%= t('post.price') %></legend>
      <div class="form-grid">
        <div class="field">
          <label for="price"><%= t('post.price') %></label>
          <input id="price" type="number" name="price" min="0" step="1" value="<%= (values.price !== undefined ? values.price : '') %>" placeholder="0">
        </div>
        <div class="field">
          <label for="price_type"><%= t('post.priceType') %></label>
          <select id="price_type" name="price_type">
            <option value="fixed" <%= values.price_type === 'fixed' ? 'selected' : '' %>><%= t('post.priceFixed') %></option>
            <option value="negotiable" <%= values.price_type === 'negotiable' ? 'selected' : '' %>><%= t('post.priceNegotiable') %></option>
            <option value="free" <%= values.price_type === 'free' ? 'selected' : '' %>><%= t('post.priceFree') %></option>
            <option value="contact" <%= values.price_type === 'contact' ? 'selected' : '' %>><%= t('post.priceContact') %></option>
          </select>
        </div>
      </div>
    </fieldset>

    <fieldset data-attr-groups>
      <legend><%= t('post.extraDetails') %> <span class="muted small">(<%= t('post.extraOptional') %>)</span></legend>
      <div data-attr-group="vehicles" hidden>
        <div class="form-grid">
          <div class="field"><label for="attr_make"><%= t('post.make') %></label><input id="attr_make" type="text" name="attr_make" maxlength="60" value="<%= (values.attr_make || '') %>"></div>
          <div class="field"><label for="attr_model"><%= t('post.model') %></label><input id="attr_model" type="text" name="attr_model" maxlength="60" value="<%= (values.attr_model || '') %>"></div>
          <div class="field"><label for="attr_year"><%= t('post.year') %></label><input id="attr_year" type="number" name="attr_year" min="1900" max="2100" value="<%= (values.attr_year || '') %>"></div>
          <div class="field"><label for="attr_odometer"><%= t('post.odometer', { unit: site.distanceUnit }) %></label><input id="attr_odometer" type="number" name="attr_odometer" min="0" value="<%= (values.attr_odometer || '') %>"></div>
        </div>
      </div>
      <div data-attr-group="jobs" hidden>
        <div class="form-grid">
          <div class="field"><label for="attr_job_type"><%= t('post.jobType') %></label>
            <select id="attr_job_type" name="attr_job_type">
              <option value=""><%= t('common.choose') %></option>
              <option value="Full-time"><%= t('post.jobFullTime') %></option><option value="Part-time"><%= t('post.jobPartTime') %></option><option value="Casual"><%= t('post.jobCasual') %></option><option value="Contract"><%= t('post.jobContract') %></option><option value="Apprenticeship"><%= t('post.jobApprenticeship') %></option>
            </select>
          </div>
          <div class="field"><label for="attr_salary"><%= t('post.salary') %></label><input id="attr_salary" type="text" name="attr_salary" maxlength="60" value="<%= (values.attr_salary || '') %>" placeholder="<%= t('post.salaryPlaceholder') %>"></div>
        </div>
      </div>
      <div data-attr-group="property-rentals" hidden>
        <div class="form-grid">
          <div class="field"><label for="attr_bedrooms"><%= t('post.bedrooms') %></label><input id="attr_bedrooms" type="number" name="attr_bedrooms" min="0" value="<%= (values.attr_bedrooms || '') %>"></div>
          <div class="field"><label for="attr_bathrooms"><%= t('post.bathrooms') %></label><input id="attr_bathrooms" type="number" name="attr_bathrooms" min="0" value="<%= (values.attr_bathrooms || '') %>"></div>
        </div>
      </div>
      <div data-attr-group="default" hidden>
        <div class="field"><label for="attr_condition"><%= t('post.condition') %></label>
          <select id="attr_condition" name="attr_condition">
            <option value=""><%= t('common.choose') %></option>
            <option value="New"><%= t('post.conditionNew') %></option><option value="Like new"><%= t('post.conditionLikeNew') %></option><option value="Good"><%= t('post.conditionGood') %></option><option value="Fair"><%= t('post.conditionFair') %></option><option value="For parts"><%= t('post.conditionParts') %></option>
          </select>
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend><%= t('post.location') %></legend>
      <div class="form-grid">
        <div class="field">
          <label for="country"><%= t('post.country') %> <span aria-hidden="true">*</span></label>
          <select id="country" name="country" required data-country>
            <% Object.entries(locations).forEach(function ([slug, c]) { %>
              <option value="<%= slug %>" <%= values.country === slug ? 'selected' : '' %>><%= c.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="field">
          <label for="state"><%= t('post.stateRegion') %> <span aria-hidden="true">*</span></label>
          <select id="state" name="state" required data-state data-value="<%= preselect.state %>" data-choose-label="<%= t('common.choose') %>">
            <option value=""><%= t('common.choose') %></option>
            <% var selectedCountry = locations[preselect.country]; %>
            <% if (selectedCountry) { Object.entries(selectedCountry.regions).forEach(function ([sSlug, s]) { %>
              <option value="<%= sSlug %>" <%= preselect.state === sSlug ? 'selected' : '' %>><%= s.name %></option>
            <% }); } %>
          </select>
          <% if (errors.state) { %><p class="field-error"><%= errors.state %></p><% } %>
        </div>
        <div class="field">
          <label for="city"><%= t('post.city') %> <span aria-hidden="true">*</span></label>
          <select id="city" name="city" required data-city data-value="<%= preselect.city %>">
            <option value=""><%= t('common.choose') %></option>
            <% var selectedState = selectedCountry && preselect.state ? selectedCountry.regions[preselect.state] : null; %>
            <% if (selectedState) { selectedState.cities.forEach(function (cityName) { %>
              <option value="<%= slugify(cityName) %>" <%= preselect.city === slugify(cityName) ? 'selected' : '' %>><%= cityName %></option>
            <% }); } %>
          </select>
          <% if (errors.city) { %><p class="field-error"><%= errors.city %></p><% } %>
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend><%= t('post.yourDetails') %></legend>
      <div class="form-grid">
        <div class="field">
          <label for="contact_name"><%= t('post.yourName') %> <span aria-hidden="true">*</span></label>
          <input id="contact_name" type="text" name="contact_name" required maxlength="80" value="<%= values.contact_name || '' %>">
          <% if (errors.contact_name) { %><p class="field-error"><%= errors.contact_name %></p><% } %>
        </div>
        <div class="field">
          <label for="contact_email"><%= t('post.email') %> <span aria-hidden="true">*</span></label>
          <input id="contact_email" type="email" name="contact_email" required maxlength="120" value="<%= values.contact_email || '' %>">
          <% if (errors.contact_email) { %><p class="field-error"><%= errors.contact_email %></p><% } %>
          <p class="hint"><%= t('post.emailHint') %></p>
        </div>
      </div>
    </fieldset>

    <div class="hp-field" aria-hidden="true"><label><%= t('post.honeypotLabel') %><input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>

    <div class="field checkbox">
      <input id="agree" type="checkbox" name="agree" value="yes" required <%= values.agree === 'yes' ? 'checked' : '' %>>
      <label for="agree" style="font-weight:400;"><%- t('post.agree', { termsHref: '/terms/', safetyHref: '/safety/' }) %></label>
    </div>
    <% if (errors.agree) { %><p class="field-error"><%= errors.agree %></p><% } %>

    <%- include('../partials/turnstile') %>

    <button class="btn btn-primary" type="submit"><%= t('post.submit') %></button>
  </form>
</div>
<%- include('../partials/foot') %>
