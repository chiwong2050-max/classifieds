<%- include('../partials/head') %>
<div class="container mt-4">
  <%- include('../partials/breadcrumbs', { items: [{ name: t('legal.privacy.title') }] }) %>
  <article class="card card-pad prose">
    <h1><%= t('legal.privacy.title') %></h1>
    <p class="muted small"><%= t('legal.privacy.updated', { date: helpers.formatDate(new Date()) }) %></p>

    <p><%= t('legal.privacy.intro', { siteName: site.name }) %></p>

    <h2><%= t('legal.privacy.collectH') %></h2>
    <%- t('legal.privacy.collectBody') %>

    <h2><%= t('legal.privacy.useH') %></h2>
    <%- t('legal.privacy.useBody') %>

    <h2><%= t('legal.privacy.sharingH') %></h2>
    <p><%= t('legal.privacy.sharingBody') %></p>

    <h2><%= t('legal.privacy.retentionH') %></h2>
    <p><%= t('legal.privacy.retentionBody') %></p>

    <h2><%= t('legal.privacy.choicesH') %></h2>
    <p><%= t('legal.privacy.choicesBody') %></p>

    <h2><%= t('legal.privacy.cookiesH') %></h2>
    <p><%= t('legal.privacy.cookiesBody') %></p>

    <p class="muted small"><%= t('legal.privacy.note') %></p>
  </article>
</div>
<%- include('../partials/foot') %>
