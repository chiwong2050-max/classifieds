<%- include('../../partials/head') %>
<div class="container mt-4">
  <%- include('../../partials/breadcrumbs', { items: [{ name: t('admin.crumbAdmin'), url: '/admin' }, { name: t('admin.crumbReviewAd') }] }) %>
  <div class="section-head">
    <h1 class="mb-0"><%= t('admin.reviewAd') %></h1>
    <span class="badge badge-<%= ad.status %>"><%= ad.status %></span>
  </div>

  <div class="ad-layout">
    <div class="stack">
      <div class="card card-pad">
        <h2><%= ad.title %></h2>
        <p class="price-tag"><%= helpers.formatPrice(ad.price_cents, ad.currency, ad.price_type) %></p>
        <p class="ad-body"><%= ad.description %></p>
      </div>

      <div class="card card-pad">
        <h2><%= t('admin.images', { count: images.length }) %></h2>
        <% if (images.length) { %>
          <div class="gallery">
            <% images.forEach(function (img) { %>
              <img src="<%= imageUrl(img.filename) %>" alt="" width="240" height="180">
            <% }); %>
          </div>
        <% } else { %><p class="muted"><%= t('admin.noImages') %></p><% } %>
      </div>
    </div>

    <aside class="stack">
      <div class="card card-pad">
        <h2 class="small"><%= t('admin.submissionDetails') %></h2>
        <ul class="detail-list">
          <li><span><%= t('admin.referenceLabel') %></span><span><%= ad.public_id.toUpperCase() %></span></li>
          <li><span><%= t('admin.categoryLabel') %></span><span><%= ad.category %></span></li>
          <li><span><%= t('admin.locationLabel') %></span><span><%= ad.city_name %>, <%= ad.state.toUpperCase() %>, <%= ad.country.toUpperCase() %></span></li>
          <li><span><%= t('admin.contactName') %></span><span><%= ad.contact_name %></span></li>
          <li><span><%= t('admin.contactEmail') %></span><span style="word-break:break-all;"><a href="mailto:<%= ad.contact_email %>"><%= ad.contact_email %></a></span></li>
          <li><span><%= t('admin.ipHash') %></span><span><%= ad.ip_hash || '—' %></span></li>
          <li><span><%= t('admin.submitted') %></span><span><%= helpers.formatDate(ad.created_at) %></span></li>
          <% Object.entries(ad.attrs).forEach(function ([k, v]) { %>
            <li><span><%= k %></span><span><%= v %></span></li>
          <% }); %>
        </ul>
      </div>

      <% if (ad.is_flagged && ad.flag_reasons.length) { %>
        <div class="card card-pad">
          <h2 class="small"><%= t('admin.autoFlags') %></h2>
          <ul class="small">
            <% ad.flag_reasons.forEach(function (f) { %>
              <li><strong><%= f.category %></strong> (<%= f.severity %>): &ldquo;<%= f.term %>&rdquo;</li>
            <% }); %>
          </ul>
        </div>
      <% } %>

      <% if (ad.reject_reason) { %>
        <div class="alert alert-err"><strong><%= t('admin.rejectionReason') %></strong> <%= ad.reject_reason %></div>
      <% } %>

      <div class="card card-pad stack">
        <h2 class="small"><%= t('admin.decision') %></h2>
        <form method="post" action="/admin/ads/<%= ad.id %>/approve">
          <button class="btn btn-primary btn-block" type="submit"><%= t('admin.approve') %></button>
        </form>
        <form method="post" action="/admin/ads/<%= ad.id %>/reject">
          <div class="field">
            <label for="reason"><%= t('admin.rejectReasonLabel') %></label>
            <textarea id="reason" name="reason" style="min-height:80px;" maxlength="500" placeholder="<%= t('admin.rejectReasonPlaceholder') %>"></textarea>
          </div>
          <button class="btn btn-danger btn-block" type="submit"><%= t('admin.reject') %></button>
        </form>
        <a class="btn btn-outline btn-block" href="/admin"><%= t('admin.backToDashboard') %></a>
      </div>
    </aside>
  </div>
</div>
<%- include('../../partials/foot') %>
