<%- include('../partials/head') %>
<div class="container mt-4">
  <%- include('../partials/breadcrumbs', { items: [{ name: t('legal.terms.title') }] }) %>
  <article class="card card-pad prose">
    <h1><%= t('legal.terms.title') %></h1>
    <p class="muted small"><%= t('legal.terms.updated', { date: helpers.formatDate(new Date()) }) %></p>

    <p><%= t('legal.terms.intro', { siteName: site.name }) %></p>

    <h2><%= t('legal.terms.policyH') %></h2>
    <p><%- t('legal.terms.policyIntro', { siteName: site.name }) %></p>
    <%- t('legal.terms.policyBody') %>

    <h2><%= t('legal.terms.postingH') %></h2>
    <%- t('legal.terms.postingBody') %>

    <h2><%= t('legal.terms.responsibilitiesH') %></h2>
    <p><%= t('legal.terms.responsibilitiesBody', { siteName: site.name }) %></p>

    <h2><%= t('legal.terms.expiryH') %></h2>
    <p><%= t('legal.terms.expiryBody', { expiryDays: expiryDays }) %></p>

    <h2><%= t('legal.terms.liabilityH') %></h2>
    <p><%= t('legal.terms.liabilityBody') %></p>

    <h2><%= t('legal.terms.changesH') %></h2>
    <p><%= t('legal.terms.changesBody') %></p>

    <p class="muted small"><%= t('legal.terms.note') %></p>
  </article>
</div>
<%- include('../partials/foot') %>
