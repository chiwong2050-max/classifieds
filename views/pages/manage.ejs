<%- include('../partials/head') %>
<div class="container mt-4">
  <div class="card card-pad prose" style="max-width:62ch;margin:0 auto;">
    <h1><%= t('manage.title') %></h1>

    <% if (renewed) { %><div class="alert alert-ok"><%= t('manage.renewed', { days: expiryDays }) %></div><% } %>

    <h2 class="mb-0"><%= ad.title %></h2>
    <p class="muted small"><%= t('manage.reference', { reference: ad.public_id.toUpperCase() }) %></p>

    <ul class="detail-list">
      <li><span><%= t('manage.status') %></span><span><span class="badge badge-<%= ad.status %>"><%= ad.status %></span></span></li>
      <li><span><%= t('manage.location') %></span><span><%= ad.city_name %></span></li>
      <% if (ad.published_at) { %><li><span><%= t('manage.published') %></span><span><%= helpers.formatDate(ad.published_at) %></span></li><% } %>
      <% if (ad.expires_at) { %><li><span><%= t('manage.expires') %></span><span><%= helpers.formatDate(ad.expires_at) %></span></li><% } %>
      <% if (ad.renewed_at) { %><li><span><%= t('manage.lastRenewed') %></span><span><%= helpers.formatDate(ad.renewed_at) %></span></li><% } %>
    </ul>

    <% if (ad.status === 'active') { %>
      <p><a href="<%= adLink %>"><%= t('manage.viewLive') %></a></p>
    <% } %>
    <% if (ad.reject_reason) { %>
      <div class="alert alert-err"><strong><%= t('manage.notApproved') %></strong> <%= ad.reject_reason %></div>
    <% } %>

    <% if (canRenew) { %>
      <p class="muted small"><%= t('manage.renewHint') %></p>
      <form method="post" action="/manage/<%= token %>/renew">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-primary" type="submit"><%= t('manage.renewButton', { days: expiryDays }) %></button>
      </form>
    <% } else if (ad.status === 'pending') { %>
      <div class="alert alert-info"><%= t('manage.awaitingNote') %></div>
    <% } else if (ad.status === 'rejected') { %>
      <div class="alert alert-err"><%= t('manage.rejectedNote') %></div>
    <% } %>

    <p class="muted small mt-4"><%= t('manage.linkNote') %></p>
    <p class="muted small"><%= t('manage.shareAd') %></p>
    <p class="small" style="word-break:break-all;"><%= absoluteAdLink %></p>
    <button class="btn btn-outline btn-sm" type="button" data-share data-title="<%= ad.title %>" data-url="<%= absoluteAdLink %>" data-copied-label="<%= t('js.linkCopied') %>" data-prompt-label="<%= t('js.copyLink') %>"><%= t('manage.copyShare') %></button>
  </div>
</div>
<%- include('../partials/foot') %>
