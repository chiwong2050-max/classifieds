<%- include('../partials/head') %>

<section class="hero">
  <div class="container">
    <h1><%= t('home.heroTitle') %></h1>
    <p class="lead"><%= t('home.heroLead') %></p>
    <div class="hero-actions mt-4">
      <a class="btn btn-primary btn-lg" href="/post/"><%= t('home.postFreeAdBtn') %></a>
      <a class="btn btn-outline btn-lg" href="/browse/"><%= t('home.browseBtn') %></a>
    </div>
    <p class="small mt-4 muted"><%= t('home.takesUnderMinute') %></p>
    <form class="searchbar mt-4" role="search" action="/search" method="get">
      <label class="hidden" for="hero-q"><%= t('nav.searchListings') %></label>
      <input id="hero-q" type="search" name="q" placeholder="<%= t('home.heroPlaceholder') %>" autocomplete="off">
      <button class="btn btn-brand" type="submit"><%= t('common.search') %></button>
    </form>
  </div>
</section>

<div class="container mt-6">

  <section class="section" aria-labelledby="how-h">
    <div class="section-head"><h2 id="how-h"><%= t('home.howTitle') %></h2></div>
    <ol class="how-strip">
      <li class="how-step">
        <span class="how-num" aria-hidden="true">1</span>
        <h3><%= t('home.howStep1Title') %></h3>
        <p class="muted small mb-0"><%= t('home.howStep1Body') %></p>
      </li>
      <li class="how-step">
        <span class="how-num" aria-hidden="true">2</span>
        <h3><%= t('home.howStep2Title') %></h3>
        <p class="muted small mb-0"><%= t('home.howStep2Body') %></p>
      </li>
      <li class="how-step">
        <span class="how-num" aria-hidden="true">3</span>
        <h3><%= t('home.howStep3Title') %></h3>
        <p class="muted small mb-0"><%= t('home.howStep3Body') %></p>
      </li>
    </ol>
  </section>

  <section class="section" aria-labelledby="cats-h">
    <div class="section-head">
      <h2 id="cats-h"><%= t('home.browseCategories') %></h2>
      <a href="/browse/" class="small"><%= t('home.viewAllCategories') %></a>
    </div>
    <div class="grid grid-cards">
      <% categories.forEach(function (c) { %>
        <a class="card tile" href="/<%= country %>/<%= c.slug %>/">
          <span class="ico"><%- include('../partials/icon', { name: c.icon }) %></span>
          <span>
            <span class="name"><%= c.name %></span><br>
            <span class="count"><%= t('home.adsCount', { count: counts[c.slug] || 0 }) %></span>
          </span>
        </a>
      <% }); %>
    </div>
  </section>

  <section class="section" aria-labelledby="recent-h">
    <div class="section-head">
      <h2 id="recent-h"><%= t('home.latestListings') %></h2>
      <a href="/<%= country %>/" class="small"><%= t('home.seeEverything') %></a>
    </div>
    <% if (recent.length) { %>
      <div class="grid grid-cards">
        <% recent.forEach(function (ad) { %>
          <%- include('../partials/adCard', { ad: ad }) %>
        <% }); %>
      </div>
    <% } else { %>
      <div class="card card-pad center">
        <h3><%= t('home.noListings') %></h3>
        <p class="muted"><%= t('home.beFirst') %></p>
        <a class="btn btn-primary" href="/post/"><%= t('home.postFreeAdBtn') %></a>
      </div>
    <% } %>
  </section>

  <section class="section" aria-labelledby="loc-h">
    <div class="section-head"><h2 id="loc-h"><%= t('home.popularLocations') %></h2></div>
    <div class="pill-row">
      <% states.forEach(function (s) { %>
        <a class="pill" href="/<%= country %>/<%= s.slug %>/"><%= s.name %></a>
      <% }); %>
    </div>
  </section>

  <section class="section">
    <div class="card card-pad">
      <h2><%= t('home.whyTitle', { siteName: site.name }) %></h2>
      <div class="grid grid-cards">
        <div><h3><%= t('home.whyHumanTitle') %></h3><p class="muted small"><%= t('home.whyHumanBody') %></p></div>
        <div><h3><%= t('home.whyFamilyTitle') %></h3><p class="muted small"><%= t('home.whyFamilyBody') %></p></div>
        <div><h3><%= t('home.whyEmailTitle') %></h3><p class="muted small"><%= t('home.whyEmailBody') %></p></div>
        <div><h3><%= t('home.whyFreeTitle') %></h3><p class="muted small"><%= t('home.whyFreeBody') %></p></div>
      </div>
    </div>
  </section>

</div>

<%- include('../partials/foot') %>
