<%- include('../partials/head') %>
<div class="container mt-6">
  <div class="card card-pad prose" style="max-width:62ch;margin:0 auto;">
    <h1><%= t('postSuccess.title') %></h1>
    <p><%= t('postSuccess.body') %></p>

    <% if (isFlagged) { %>
      <div class="alert alert-warn"><%= t('postSuccess.flagged') %></div>
    <% } %>

    <div class="alert alert-info">
      <strong><%= t('postSuccess.keepLink') %></strong><br>
      <a href="/manage/<%= manageToken %>"><%= site.url %>/manage/<%= manageToken %></a>
    </div>

    <p class="muted small"><%= t('postSuccess.emailPrivate') %></p>
    <div class="row">
      <a class="btn btn-outline" href="/"><%= t('postSuccess.backHome') %></a>
      <a class="btn btn-primary" href="/post/"><%= t('postSuccess.postAnother') %></a>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
