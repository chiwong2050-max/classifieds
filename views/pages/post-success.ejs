<%- include('../partials/head') %>
<div class="container mt-6">
  <div class="card card-pad prose" style="max-width:62ch;margin:0 auto;">
    <h1>Thanks &mdash; your ad is in the queue</h1>
    <p>Your ad has been submitted and is now awaiting review. Most ads are checked within a few hours. You'll get an email as soon as it's live.</p>

    <% if (isFlagged) { %>
      <div class="alert alert-warn">Our automated checks flagged a word in your ad, so it will get closer attention from a moderator. If everything is fine, it will be approved as normal.</div>
    <% } %>

    <div class="alert alert-info">
      <strong>Keep this link</strong> to manage or renew your ad later:<br>
      <a href="/manage/<%= manageToken %>"><%= site.url %>/manage/<%= manageToken %></a>
    </div>

    <p class="muted small">Your email stays private. Buyers reach you through a relay form.</p>
    <div class="row">
      <a class="btn btn-outline" href="/">Back to home</a>
      <a class="btn btn-primary" href="/post/">Post another ad</a>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
