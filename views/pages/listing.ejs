<%- include('../partials/head') %>
<% var hasArea = typeof areaHub !== 'undefined' && areaHub; %>
<div class="container mt-4">
  <%- include('../partials/breadcrumbs', { items: crumbs }) %>

  <% if (hasArea) { %>
    <%- include('../partials/areaHub', { area: areaHub }) %>
  <% } %>

  <div class="section-head">
    <div>
      <% if (hasArea) { %>
        <h2 class="mb-0"><%= t('area.freeAdsTitle', { area: areaHub.name }) %></h2>
      <% } else { %>
        <h1 class="mb-0"><%= loc.category ? (categories.find(c => c.slug === loc.category) || {}).name : t('listing.allCategories') %><% if (loc.cityName) { %> <%= t('listing.inPlace', { place: loc.cityName }) %><% } else if (loc.stateName) { %> <%= t('listing.inPlace', { place: loc.stateName }) %><% } else { %> <%= t('listing.inPlace', { place: loc.countryName }) %><% } %></h1>
      <% } %>
      <p class="muted"><%= tp('listing.count', total) %></p>
    </div>
    <a class="btn btn-primary" href="/post/?country=<%= loc.country %>&state=<%= loc.state || '' %>&city=<%= loc.city || '' %>&category=<%= loc.category || '' %>"><%= hasArea ? t('area.postFreeAd', { area: areaHub.name }) : t('listing.postHere') %></a>
  </div>

  <% if (loc.category === 'pets') { %>
    <% var petsCat = categories.find(c => c.slug === 'pets'); %>
    <% if (petsCat && petsCat.policy) { %><div class="alert alert-info small"><%= petsCat.policy %></div><% } %>
  <% } %>

  <section class="card card-pad mb-4" aria-label="<%= t('listing.filtersAria') %>">
    <form method="get" action="<%= baseUrl %>">
      <% if (isSearch) { %>
        <%# Preserve the chosen scope when refining a global search. %>
        <input type="hidden" name="country" value="<%= loc.country %>">
        <% if (loc.state) { %><input type="hidden" name="state" value="<%= loc.state %>"><% } %>
        <% if (loc.city) { %><input type="hidden" name="city" value="<%= loc.city %>"><% } %>
        <% if (loc.category) { %><input type="hidden" name="category" value="<%= loc.category %>"><% } %>
      <% } %>
      <div class="filters">
        <div class="field">
          <label for="f-q"><%= t('listing.keyword') %></label>
          <input id="f-q" type="search" name="q" value="<%= query.q || '' %>" placeholder="<%= t('listing.keywordPlaceholder') %>">
        </div>
        <div class="field">
          <label for="f-min"><%= t('listing.minPrice') %></label>
          <input id="f-min" type="number" name="priceMin" min="0" step="1" value="<%= query.priceMin || '' %>" placeholder="0">
        </div>
        <div class="field">
          <label for="f-max"><%= t('listing.maxPrice') %></label>
          <input id="f-max" type="number" name="priceMax" min="0" step="1" value="<%= query.priceMax || '' %>" placeholder="<%= t('listing.any') %>">
        </div>
        <div class="field">
          <label for="f-sort"><%= t('listing.sort') %></label>
          <select id="f-sort" name="sort">
            <option value="recent" <%= sort === 'recent' ? 'selected' : '' %>><%= t('listing.sortRecent') %></option>
            <option value="price-asc" <%= sort === 'price-asc' ? 'selected' : '' %>><%= t('listing.sortPriceAsc') %></option>
            <option value="price-desc" <%= sort === 'price-desc' ? 'selected' : '' %>><%= t('listing.sortPriceDesc') %></option>
          </select>
        </div>
      </div>
      <div class="row mt-4">
        <button class="btn btn-brand" type="submit"><%= t('listing.applyFilters') %></button>
        <a class="btn btn-outline" href="<%= baseUrl %>"><%= t('listing.reset') %></a>
      </div>
    </form>
  </section>

  <div class="pill-row mb-4">
    <a class="pill <%= !loc.category ? 'active' : '' %>" href="<%= urls.listingUrl({ country: loc.country, state: loc.state, city: loc.city }) %>"><%= t('listing.all') %></a>
    <% allCategories.forEach(function (c) { %>
      <a class="pill <%= loc.category === c.slug ? 'active' : '' %>" href="<%= urls.listingUrl({ country: loc.country, state: loc.state, city: loc.city, category: c.slug }) %>"><%= c.name %> (<%= categoryCounts[c.slug] || 0 %>)</a>
    <% }); %>
  </div>

  <% if (rows.length) { %>
    <div class="grid grid-cards">
      <% rows.forEach(function (ad) { %><%- include('../partials/adCard', { ad: ad }) %><% }); %>
    </div>
    <%- include('../partials/pagination', { page: page, totalPages: totalPages, baseUrl: baseUrl, query: query }) %>
  <% } else { %>
    <%# Empty state: no fake listings, just an invitation plus plain-text ideas. %>
    <% var ideaSet = ['for-sale', 'jobs', 'services', 'property-rentals', 'vehicles', 'community', 'wanted', 'pets'].indexOf(loc.category) !== -1 ? loc.category : 'default'; %>
    <div class="card card-pad center empty-state">
      <h3 class="empty-title"><%= t('listing.emptyTitle', { countryName: loc.countryName }) %></h3>
      <p class="muted"><%= t('listing.noResultsBody') %></p>
      <p class="mt-4"><a class="btn btn-primary btn-lg" href="/post/?country=<%= loc.country %>&state=<%= loc.state || '' %>&city=<%= loc.city || '' %>&category=<%= loc.category || '' %>"><%= t('listing.emptyCta') %></a></p>
      <p class="small muted mt-6 mb-2"><%= t('listing.emptyIdeasTitle') %></p>
      <ul class="idea-list small">
        <li><%= t('listing.ideas.' + ideaSet + '.1') %></li>
        <li><%= t('listing.ideas.' + ideaSet + '.2') %></li>
        <li><%= t('listing.ideas.' + ideaSet + '.3') %></li>
      </ul>
      <% if (isSearch || query.q || query.priceMin || query.priceMax) { %>
        <p class="mt-6 mb-0"><a class="small" href="<%= baseUrl %>"><%= t('listing.clearFilters') %></a></p>
      <% } %>
    </div>
  <% } %>

  <% if (siblingCities.length) { %>
    <section class="section">
      <h2 class="small muted"><%= t('listing.nearbyCities') %></h2>
      <div class="pill-row">
        <% siblingCities.forEach(function (c) { %>
          <a class="pill" href="<%= urls.listingUrl({ country: loc.country, state: loc.state, city: c.slug, category: loc.category }) %>"><%= c.name %></a>
        <% }); %>
      </div>
    </section>
  <% } %>
</div>
<%- include('../partials/foot') %>
