# ---------------------------------------------------------------------------
# Classifieds - environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Branding (configurable)
SITE_NAME=Classifieds
SITE_TAGLINE=Buy, sell and connect locally
# Public base URL, no trailing slash. Used for canonical URLs, magic links, sitemap.
SITE_URL=http://localhost:3000
# Default locale/country
DEFAULT_COUNTRY=au

# Server
PORT=3000
NODE_ENV=development
# Secret used to sign session cookies and tokens. Change in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Admin
# Password required to access /admin (approve/reject ads, view reports).
ADMIN_PASSWORD=change-me-admin-password

# Email (magic links, renew links, contact relay).
# In development the default "console" transport just logs messages to stdout.
MAIL_TRANSPORT=console
MAIL_FROM="Classifieds <no-reply@example.com>"
# SMTP settings (only used when MAIL_TRANSPORT=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Image uploads
UPLOAD_DIR=public/uploads
MAX_IMAGES_PER_AD=6

# Ad lifecycle
AD_EXPIRY_DAYS=30

# Cloudflare Turnstile (bot protection). Leave blank to disable.
# Get keys at https://dash.cloudflare.com/ -> Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Footer support link
BUYMEACOFFEE_URL=https://buymeacoffee.com/aussieloo?ref=classifieds
