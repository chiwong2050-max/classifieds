# ---------------------------------------------------------------------------
# ListNear - environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Market selection (multi-market engine)
# ---------------------------------------------------------------------------
# One codebase runs many ListNear markets (US, AU, custom). Each market is
# described by a JSON file in `src/config/sites/<key>.json` that defines the
# branding, country, currency, locale, date/units format, database file and the
# seeded list of regions/cities.
#
# Choose the market with SITE (defaults to `au`). Point SITE_CONFIG at an
# absolute or repo-relative path to load a custom market file instead.
#
#   US site -> https://listnear.app      SITE=us  DB_PATH=data/us.sqlite
#   AU site -> https://au.listnear.app   SITE=au  DB_PATH=data/au.sqlite
SITE=au
# SITE_CONFIG=./config/my-market.json

# Any value from the market file can be overridden here without editing code,
# which is how the same build serves separate domains with separate databases.
SITE_NAME=ListNear
SITE_TAGLINE=Buy, sell, jobs, services and more near you.
# Two-letter country code used in URLs (e.g. /au/...) and location data.
SITE_COUNTRY=au
SITE_COUNTRY_NAME=Australia
# Default currency for new ads (ISO 4217).
SITE_CURRENCY=AUD
# Locale controls date/price formatting; language picks the base locale file.
SITE_LOCALE=en-AU
SITE_LANGUAGE=en
# Date pattern tokens: D, M, MM, MMM, MMMM, YY, YYYY (e.g. "D MMM YYYY" or "MMM D, YYYY").
SITE_DATE_FORMAT=D MMM YYYY
# Measurement system: `metric` (km) or `imperial` (mi).
SITE_UNITS=metric
# Public contact address shown on the /contact page.
SITE_CONTACT_EMAIL=support@listnear.app
# Emergency number shown on the safety page.
EMERGENCY_NUMBER=000

# Public base URL, no trailing slash. Used for canonical URLs, magic links and
# the sitemap. Give each market its own domain.
SITE_URL=https://au.listnear.app

# Per-market database file. Separate databases keep each market's ads isolated.
DB_PATH=data/au.sqlite

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Bind address. Defaults to loopback; set HOST=0.0.0.0 behind a reverse proxy
# or in a container so the site is reachable.
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# Secret used to sign session cookies and tokens. Change in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Admin
# Password required to access /admin (approve/reject ads, view reports).
ADMIN_PASSWORD=change-me-admin-password

# Email (magic links, renew links, contact relay).
# In development the default "console" transport just logs messages to stdout.
MAIL_TRANSPORT=console
MAIL_FROM="ListNear <no-reply@listnear.app>"
# SMTP settings (only used when MAIL_TRANSPORT=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Image uploads
UPLOAD_DIR=public/uploads
MAX_IMAGES_PER_AD=6

# Ad lifecycle
AD_EXPIRY_DAYS=30

# Cloudflare Turnstile (bot protection). Leave blank to disable.
# Get keys at https://dash.cloudflare.com/ -> Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Footer support link
SUPPORT_URL=https://buymeacoffee.com/aussieloo?ref=listnear
