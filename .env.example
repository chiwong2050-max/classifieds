# ---------------------------------------------------------------------------
# ListNear - environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Market selection (multi-market engine)
# ---------------------------------------------------------------------------
# ONE process serves EVERY market. The market is detected per request from the
# `Host` header: the United States is the apex (listnear.app, with www -> apex)
# and every other country is its own subdomain (<cc>.listnear.app, e.g.
# au.listnear.app). No SITE= is needed in production.
#
# The country catalogue lives in src/config/countries.js (currency, locale,
# dial code, emergency number and the seeded regions/cities in regions.js).
#
# The values below only affect the DEFAULT market - the fallback used for hosts
# that do not match the root domain (localhost, 127.0.0.1, IPs) and for CLI
# scripts. They never change the host-resolved markets.
#
#   local dev default -> https://au.listnear.app (AU)
SITE=au
# SITE_CONFIG=./config/my-overlay.json   # merged into the DEFAULT market only

# Which countries are LIVE. Set it to a comma-separated allow-list of ISO codes
# to turn batches on without a code edit; leave it unset to use the repo default
# (us,au). A country must also have region/city data (regions.js) to go live;
# everything else answers on its Host with a "coming soon" page (noindex).
# LISTNEAR_ENABLED_COUNTRIES=us,au,gb,ca,nz

# Optional default-market overrides (leave blank to use catalogue values).
SITE_NAME=ListNear
SITE_TAGLINE=Buy, sell, jobs, services and more near you.
# Default currency for new ads (ISO 4217).
SITE_CURRENCY=AUD
# Locale controls date/price formatting and <html lang>; language picks the base
# locale file (locales/<language>.json).
SITE_LOCALE=en-AU
SITE_LANGUAGE=en
# Date pattern tokens: D, M, MM, MMM, MMMM, YY, YYYY (e.g. "D MMM YYYY" or "MMM D, YYYY").
SITE_DATE_FORMAT=D MMM YYYY
# Measurement system: `metric` (km) or `imperial` (mi).
SITE_UNITS=metric
# Public contact address shown on the /contact page.
SITE_CONTACT_EMAIL=support@listnear.app
# Emergency number shown on the safety page (blank falls back to a generic line).
EMERGENCY_NUMBER=000

# Apex domain used for host resolution and country subdomains.
ROOT_DOMAIN=listnear.app

# Public base URL of the default market, no trailing slash. Used for canonical
# URLs, magic links and the sitemap. Leave blank to use the market's own origin.
# SITE_URL=https://au.listnear.app

# Where the databases live. With DB_DIR set, each country gets its own file at
# <DB_DIR>/<cc>.sqlite; otherwise the repo-relative data/<cc>.sqlite is used.
# DB_DIR=/home/ausweb/data/classifieds
# DB_PATH overrides the DEFAULT market's file only (single-market runs).
DB_PATH=data/au.sqlite

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Bind address. Defaults to loopback; set HOST=0.0.0.0 behind a reverse proxy
# or in a container so the site is reachable.
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# Secret used to sign session cookies and tokens. Change in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Admin
# Password required to access /admin (approve/reject ads, view reports).
ADMIN_PASSWORD=change-me-admin-password

# Email (magic links, renew links, contact relay).
# In development the default "console" transport just logs messages to stdout.
MAIL_TRANSPORT=console
MAIL_FROM="ListNear <no-reply@listnear.app>"
# SMTP settings (only used when MAIL_TRANSPORT=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Image uploads
# Base directory. Each market stores its files in <UPLOAD_DIR>/<cc>, and only
# the current market's directory is served at /uploads.
UPLOAD_DIR=public/uploads
MAX_IMAGES_PER_AD=6

# Ad lifecycle
AD_EXPIRY_DAYS=30

# Area pages (mini community hub per suburb/town)
# One JSON file per area is produced by scripts/areas/build.js on the data host
# and copied to <AREAS_DIR>/<cc>/<state>/<slug>.json
# (e.g. data/areas/au/vic/bendigo.json). Generated output is git-ignored; the
# loader validates every file and skips bad ones with a log line.
AREAS_DIR=data/areas
# Rollout allow-list: a comma-separated list of country codes or cc:state pairs,
# e.g. `au`, `au:vic,au:nsw` or `au,us:ca`. Unset/empty means no new
# restriction. A disabled country/state renders as if it had no area file.
AREA_PAGES_ENABLED=
# The only indexing kill-switch. While false (the default) every area page is
# noindex,follow and none is listed in /sitemap.xml. When true, only rich pages
# (a Wikipedia intro plus two real sections, or a real post) that the rollout
# allow-list also enables are indexed and listed.
AREA_PAGES_INDEXING=false

# Cloudflare Turnstile (bot protection). Leave blank to disable.
# Get keys at https://dash.cloudflare.com/ -> Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Footer support link
SUPPORT_URL=https://buymeacoffee.com/aussieloo?ref=listnear

# Ad network is intentionally off. No AdSense (or any ad) code is rendered.
ADS_ENABLED=false
