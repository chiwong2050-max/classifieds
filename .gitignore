# Dependencies
node_modules/

# Environment / secrets
.env
.env.local
.env.*.local

# SQLite database (generated at runtime)
data/*.sqlite
data/*.sqlite-journal
data/*.sqlite-wal
data/*.sqlite-shm

# Area-page JSON (generated by scripts/areas/build.js on the data host, then
# copied to the app host's AREAS_DIR). Never committed; test fixtures live under
# test/fixtures/areas/ instead.
data/areas/
data/areas-out/
data/areas-src/
.cache/areas/

# User-uploaded images (generated at runtime)
public/uploads/*
!public/uploads/.gitkeep

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
